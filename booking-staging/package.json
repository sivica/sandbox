{
  "name": "kindred-booking-staging",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "migrate": "node server/migrate.js",
    "start": "node server/index.js",
    "test:unit": "node --test tests/calendar.test.js",
    "test:api": "node --env-file-if-exists=.env --test tests/api.test.js",
    "test:browser": "playwright test",
    "test": "npm run test:unit && npm run test:api && npm run test:browser"
  },
  "dependencies": {
    "express": "5.2.1",
    "luxon": "3.7.2",
    "pg": "8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.9"
  }
}
